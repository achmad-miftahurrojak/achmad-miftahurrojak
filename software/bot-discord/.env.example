# ============================================================
# CONTOH FILE ENVIRONMENT — salin jadi .env lalu isi nilai asli
# JANGAN pernah commit .env yang berisi token asli
# ============================================================

# --- Database (wajib) ---
DATABASE_URL="postgresql://user:password@localhost:5432/haminbot?schema=public"

# --- Token bot Discord (isi sesuai bot yang dijalankan) ---
JULIAN_TOKEN=
DIRGA_TOKEN=
ARKA_TOKEN=
KEVIN_TOKEN=
TIDETUNES_TOKEN=
WAVEFLIX_TOKEN=

# --- AI provider ---
GEMINI_API_KEY=          # Dirga (obrolan), TideTunes (AI Auto-DJ)
OPENROUTER_API_KEY=      # cadangan Dirga
GROQ_API_KEY=            # cadangan Dirga
CEREBRAS_API_KEY=        # cadangan Dirga
TMDB_API_KEY=            # WaveFlix (cari film)

# --- Opsional: ID channel/role (ada fallback hardcoded di config masing-masing) ---
DIRGA_CLIENT_ID=
LOG_CHANNEL_ID=
LOG_LEVEL=info
BOT_EVENTS_ENABLED=false

ARKA_CHANNEL_ARENA=
ARKA_CHANNEL_REKAP=
