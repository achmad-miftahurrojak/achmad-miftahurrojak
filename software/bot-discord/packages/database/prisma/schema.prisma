generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id // Discord User ID
  xp            Int       @default(0)
  xpMinggu      Int       @default(0)
  pesan         Int       @default(0)
  menit         Int       @default(0)
  absen         Int       @default(0)
  absenPanjang  Int       @default(0)
  absenTerakhir DateTime? // Maps to 'absen_terakhir' (e.g. "2026-08-11")
  menang        Int       @default(0)
  kalah         Int       @default(0)
  juara         Int       @default(0)
  lastActive    DateTime? @default(now())

  // One-to-one relation with game stats
  gameStats GameStats?
  dirgaProfile DirgaProfile?
  arkaUser ArkaUser?
}

model GameStats {
  id     Int    @id @default(autoincrement())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  duelMain   Int @default(0)
  duelMenang Int @default(0)
  duelMinggu Int @default(0)

  // Can add more game stats (hunt, etc) as needed based on the JSON
}

model SongTrivia {
  id       Int    @id @default(autoincrement())
  judul    String
  penyanyi String
  tahun    Int
  genre    String
  emoji    String
}

model Warn {
  id        Int        @id @default(autoincrement())
  userId    String // Discord User ID of the warned user
  moderator String // Discord User ID of the moderator
  reason    String
  createdAt DateTime   @default(now())
  expiresAt DateTime?
}

model Bookmark {
  id        Int      @id @default(autoincrement())
  userId    String // Discord User ID
  name      String
  link      String
  createdAt DateTime @default(now())
}

model Ticket {
  id        Int      @id @default(autoincrement())
  channelId String   @unique // Discord Channel ID
  userId    String // Creator of the ticket
  status    String   @default("OPEN") // OPEN, CLOSED
  createdAt DateTime @default(now())
}

model Resource {
  id        Int      @id @default(autoincrement())
  judul     String
  link      String   @unique
  kategori  String
  catatan   String?
  oleh      String
  createdAt DateTime @default(now())
}

model Starboard {
  id            Int      @id @default(autoincrement())
  messageId     String   @unique // Original message ID
  starMessageId String // Starboard post ID
  channelId     String // Original channel ID
  authorId      String // Author Discord ID
  createdAt     DateTime @default(now())
}

// ==========================================
// DIRGA BOT MODELS
// ==========================================

model DirgaSettings {
  id               Int      @id @default(autoincrement())
  channelNgobrolId String?  // ID of the channel Dirga replies automatically
  channelReviveId  String?  // ID of the channel to revive
  roleReviveId     String?  // Role to ping for revive
  lastRevive       DateTime? // Last time the chat was revived
  updatedAt        DateTime @updatedAt
}

model DirgaProfile {
  id        Int      @id @default(autoincrement())
  userId    String   @unique // Discord User ID
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nama      String?  // User's known name
  catatan   String[] // Array of notes about the user
  updatedAt DateTime @default(now()) @updatedAt
}

model DirgaHistory {
  id        Int      @id @default(autoincrement())
  userId    String   // Discord User ID
  role      String   // 'user' or 'model'
  content   String   // The message content
  createdAt DateTime @default(now())
  
  @@index([userId, createdAt])
}

// ==========================================
// ARKA BOT MODELS
// ==========================================

model ArkaGlobal {
  id              Int      @id @default(1)
  cuacaTanggal    String?
  cuacaNama       String?
  cuacaKali       Float?
  cuacaEmoji      String?
  cuacaKata       String?
  cuacaDiumumkan  Boolean  @default(false)
  petKenyang      Float    @default(0.0)
  petTerakhir     DateTime @default(now())
  season          Int      @default(1)
  misi            Json?
  quest           Json?
  misiKemarinDaftar Json?
  lombaAcara      Json?
  toko            Json?
  rantai          Json?
  kapsul          Json?
  kapsulTerakhir  String?
  seasonData      Json?
  rekapTerakhir   String?
  rekapGiliran    Int      @default(0)
  petNama         String?
  petTotalMakan   Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model ArkaUser {
  id             Int      @id @default(autoincrement())
  userId         String   @unique // Discord User ID
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  terakhirAktif  String?  // format YYYY-MM-DD
  hampirDikabarin String?
  
  // JSON fields for complex nested dicts from data-arka.json
  game         Json?
  misi         Json?
  efek         Json?
  barang       Json?
  koleksi      Json?
  misiMinggu   Json?
  kasihHarian  Json?
  kasihKe      Json?
  misiKemarin  Json?
  wishlist     Json?
  absenRiwayat Json?
  petMakan     Json?
  xpAbadi      Int      @default(0)
}

model OutboxEvent {
  id          String          @id
  sequence    BigInt          @unique @default(autoincrement())
  type        String
  guildId     String
  entityId    String?
  version     Int             @default(1)
  payload     Json
  createdAt   DateTime        @default(now())
  deliveries  OutboxDelivery[]

  @@index([guildId, createdAt])
}

model EventConsumer {
  consumer    String   @id
  lastSequence BigInt  @default(0)
  updatedAt   DateTime @updatedAt
}

model OutboxDelivery {
  id          Int          @id @default(autoincrement())
  eventId     String
  consumer    String
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  lockedUntil DateTime?
  processedAt DateTime?
  failedAt    DateTime?
  lastError   String?
  createdAt   DateTime     @default(now())
  event       OutboxEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, consumer])
  @@index([consumer, processedAt, availableAt])
}
