{
  "name": "jurnalis-org",
  "version": "4.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @jurnalis-org/web",
    "dev:api": "npm run dev -w @jurnalis-org/api",
    "build:web": "npm run build -w @jurnalis-org/web",
    "build:api": "npm run build -w @jurnalis-org/api",
    "typecheck": "npm run typecheck -w @jurnalis-org/api && npm run typecheck -w @jurnalis-org/web",
    "lint": "npm run lint -w @jurnalis-org/web",
    "build": "turbo run build",
    "dev": "turbo run dev"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "turbo": "latest"
  }
}
